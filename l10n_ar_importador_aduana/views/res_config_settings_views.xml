<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_dua" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.dua</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='account']" position="inside">
                <block title="Customs Clearances (DUA)" name="l10n_ar_dua_settings_block">
                    <setting string="DUA Tariff Account"
                             help="Expense account for TARIFF (code 010). If not configured, account 509.71 is used.">
                        <field name="l10n_ar_dua_account_arancel_id"/>
                    </setting>
                    <setting string="Statistical Fee / SIM Account"
                             help="Account for STATISTICAL FEE (011/061) and SIM (500). If not configured, account 509.55 is used.">
                        <field name="l10n_ar_dua_account_estadistica_id"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
